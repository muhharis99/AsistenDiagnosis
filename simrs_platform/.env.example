APP_MODE=demo
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
SIMRS_TIME_ZONE=Asia/Jakarta

# Generate these locally; never commit real secrets.
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MPI_ENCRYPTION_KEY=
# Random secret with at least 32 bytes, unique per environment.
MPI_HMAC_KEY=

# Leave DB_HOST empty to use local SQLite for quick demo.
DB_HOST=
DB_NAME=simrs
DB_USER=simrs
DB_PASSWORD=
DB_PORT=5432
DB_CONN_MAX_AGE=60

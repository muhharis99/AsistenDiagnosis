# Template saja. Jangan commit kunci asli.
APP_MODE=demo
DATABASE_URL=sqlite:///./instance/rme_demo.db
PII_ENCRYPTION_KEY=
IDLE_TIMEOUT_MINUTES=20
FACILITY_NAME=Klinik Demo Sehat (FIKTIF)
SATUSEHAT_MODE=mock
